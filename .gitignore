# MAME working state and shadow romset (contains symlinks to the user's ROMs)
.mame/
# The user's romset — never commit ROMs.  Anchored: an unanchored name also
# matches pkg/pocket/Assets/<name>/ (METHODOLOGY section 5.6).
/smashtv/
*.zip
*.rom
*.bin
!pkg/**/*.bin
# Build products
projects/db/
projects/incremental_db/
projects/output_files/
.build/
release/
sim/obj_*/
tmp/
**/__pycache__/
.DS_Store

# Recorded audio: large, and regenerated by the benches and the MAME probes.
# They land in artifacts/audio/ for listening to locally; the comparison
# report next to them is what gets committed.
artifacts/audio/*.wav

# sim/lint.sh builds its waiver file to match the installed Verilator
sim/waivers.vlt
sim/obj_*.log

# raw frame dumps from the benches; the PNG beside each is what is kept
artifacts/**/*.rgb

# Quartus byproducts
projects/c5_pin_model_dump.txt
projects/*.qws

# Captured reference states, traces and MAME pictures: 18 MB, and exactly
# reproducible from the romset with tools/dump_states.sh, so they are not
# committed.  ref/states/README.md says how.
/ref/states/*
!/ref/states/README.md
# the renderer's own pictures and diffs, for looking at
/artifacts/video/

# MAME run outside tools/mame.sh drops snapshots here
/snap/
# CPU traces: hundreds of megabytes, regenerated by tools/cpu_trace.sh
/ref/cputrace/
